# OpenWrt and Go build outputs
bin/
build_dir/
staging_dir/
dl/
tmp/
logs/
target/
build/
output/
outputs/
dist/
release/
DerivedData/
mobile/android/.kotlin/
*.xcarchive
*.dSYM
*.ipa
*.aab
*.zip
*.ipk
*.bin
*.gz
openwrt/opensocks/src/opensocks
# Go binaries built locally (the daemon's module name is dev.opensocks.daemon).
openwrt/opensocks/src/dev.opensocks.daemon
openwrt/opensocks/src/dev.opensocks.daemon.exe
*.exe

# Android app bundle. OpenWrt .apk packages are build outputs too, but they land
# in release/, so this pattern is scoped to the mobile tree to keep an .apk
# fixture in openwrt/ committable if one is ever added.
mobile/**/*.apk

# Runtime configuration and credentials
etc/opensocks/
credentials.json
credentials.enc
credentials.key
*.sec
traffic.json
history.json
*.log
*.pcap

# Editors and operating systems
.DS_Store
.idea/
.vscode/
*.swp
*~
